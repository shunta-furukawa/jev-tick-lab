[Unit]
Description=jev-tick-lab - Jev day-trading reproduction experiment
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jevbot
WorkingDirectory=/opt/jev-tick-lab

# Secrets come from the environment only. Populate this file at boot from
# Secret Manager; never bake a key into the image or commit one.
EnvironmentFile=/etc/jev-tick-lab/env

ExecStart=/opt/jev-tick-lab/bot -pair xrp_jpy -mode shadow -model jev-1.13.0 -log-dir /opt/jev-tick-lab/data

Restart=always
RestartSec=5

# SIGTERM lets the tick loop finish and flush the log. In live mode this window
# is also where positions must be flattened, so do not shorten it.
KillSignal=SIGTERM
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/jev-tick-lab/data

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
