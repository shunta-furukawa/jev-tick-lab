# Copy to terraform.tfvars and fill in. Everything else has a default.
project_id = "your-gcp-project"

# Defaults worth knowing about:
# region       = "asia-northeast1"
# zone         = "asia-northeast1-b"
# machine_type = "e2-small"
# pair         = "xrp_jpy"
# model        = "jev-1.13.0"   # pinned, never an alias
# mode         = "shadow"

# Set this and you get two alerts: "the data went bad" and, more importantly,
# "nothing has reported in three hours". Leave it empty for no alerting.
# alert_email = "you@example.com"
